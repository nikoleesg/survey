{
    "name": "nikoleesg/survey",
    "description": "Store and query survey variables, answers and paradata for Laravel",
    "keywords": [
        "laravel",
        "survey"
    ],
    "homepage": "https://github.com/nikoleesg/survey",
    "license": "MIT",
    "authors": [
        {
            "name": "Niko Lee",
            "email": "Niko.lee@outlook.sg",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "awobaz/compoships": "^3.1",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/eloquent-sortable": "^4.5|^5.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.14.0",
        "spatie/laravel-sluggable": "^3.8|^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nikoleesg\\Survey\\": "src/",
            "Nikoleesg\\Survey\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nikoleesg\\Survey\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-survey --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nikoleesg\\Survey\\SurveyServiceProvider"
            ],
            "aliases": {
                "Survey": "Nikoleesg\\Survey\\Facades\\Survey"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
